FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
CODEX_BIN=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_SERVICE_TIER=
CODEX_NETWORK_ACCESS=true
CODEX_APPROVAL_POLICY=never
CODEX_IGNORE_EXEC_RULES=true
CODEX_IDLE_TIMEOUT_MS=300000
CODEX_MAX_RUNTIME_MS=1800000
ALLOW_NON_OWNER=false
ALLOW_USERS=
ALLOW_CHATS=
ENABLE_PROGRESS_UPDATES=false
AUTO_REDIRECT_WHEN_BUSY=true
FEISHU_TOOLS=true
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
TTS_VOICE=Tingting

# ============ owner 身份（v2.x 新增）============
# owner 的 open_id。强烈建议设置：即使 data/owner.json 丢失/损坏，
# 你也不会被降级成访客，更不会被别人抢走 owner 身份。
OWNER_OPEN_ID=

# owner 记录缺失时是否允许「首个私聊者自动认领」。默认关闭——
# 盘故障或误删后，下一个私聊机器人的人会继承你的全部权限。
# ALLOW_OWNER_CLAIM=

# ============ 访客隔离（除非清楚后果，否则不要改）============
# GUEST_WORKSPACE_DIR=   # 访客工作区，默认 ./workspace-guest；必须与 owner 工作区分离
# 注：访客固定跑 --sandbox read-only，且不注入任何记忆。
# read-only 只挡写不挡读，所以工作区隔离与沙箱级别缺一不可。

# ============ 调度与记忆（v2.x 新增）============
# SCHED_MAX_LATE_MS=7200000      # 迟到超过该值就跳过不补跑（默认 2 小时）
# SCHED_MAX_CONCURRENT=2         # 定时任务并发上限
# CONTEXT_NUDGE_TOKENS=850000    # 上下文超过该值提醒固化记忆；0=关闭
# MEMORY_RECALL_MAX=3            # 每条消息最多召回几条相关记忆
# INCOMING_TTL_MS=1209600000     # 附件保留时长（默认 14 天）

# ============ 其他（v2.x 新增）============
# WS_PING_TIMEOUT_SEC=30         # 长连接心跳看门狗
# PROGRESS_MIN_INTERVAL_MS=3000  # 进度卡片最小更新间隔
# STARTUP_NOTICE=                # 设 false 关闭「桥接已启动」通知
# DIAG_MODEL=                    # 定时任务失败自诊断用的模型
# CODEX_MAX_RETRIES=2            # 网络类失败重试次数，0=关闭
